# === AxaWeb environment variables ===
# Kopieer naar .env lokaal indien nodig. Zet secrets alleen in Vercel Project Settings.
# Nooit API-keys of secrets in client-side JS plaatsen.

# Ontvanger van contactaanvragen (FormSubmit)
# Standaard: info@axaweb.nl
CONTACT_TO_EMAIL=info@axaweb.nl

# Toegestane Origins voor POST /api/contact (komma-gescheiden)
# Standaard: https://axaweb.nl,https://www.axaweb.nl
# Preview-deploys voegen automatisch VERCEL_URL toe.
# ALLOWED_ORIGINS=https://axaweb.nl,https://www.axaweb.nl

# Door Vercel gezet (niet handmatig nodig):
# VERCEL_ENV=production|preview|development
# VERCEL_URL=<deployment-host>
# NODE_ENV=production
