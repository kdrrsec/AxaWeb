# === AxaWeb environment variables ===
# Kopieer naar .env lokaal indien nodig. Zet waarden in Vercel Project Settings.
# Nooit echte IDs of secrets committen. Ontbrekende analytics-IDs = stil uitgeschakeld.

# Ontvanger van contactaanvragen (FormSubmit)
CONTACT_TO_EMAIL=info@axaweb.nl

# Toegestane Origins voor POST /api/contact (komma-gescheiden)
# ALLOWED_ORIGINS=https://axaweb.nl,https://www.axaweb.nl

# --- Publieke analytics / verificatie (build-time injectie) ---
# Google Analytics 4 Measurement ID (alleen na cookietoestemming Statistieken)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity Project ID (alleen na cookietoestemming Statistieken)
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Google Search Console verification token (meta-tag; leeg = geen tag)
GOOGLE_SITE_VERIFICATION=

# Aliassen (optioneel, zelfde effect):
# PUBLIC_GA_MEASUREMENT_ID=
# PUBLIC_CLARITY_PROJECT_ID=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Door Vercel gezet (niet handmatig nodig):
# VERCEL_ENV=production|preview|development
# VERCEL_URL=<deployment-host>
# NODE_ENV=production
