{
  "name": "axaweb",
  "version": "1.0.0",
  "private": true,
  "description": "AxaWeb official website",
  "type": "module",
  "scripts": {
    "lint": "eslint \"js/**/*.js\" \"scripts/**/*.js\" \"i18n/**/*.js\" \"api/**/*.js\" \"data/**/*.js\"",
    "typecheck": "node scripts/typecheck.js",
    "generate:pages": "node scripts/generate-pages.js",
    "build": "node scripts/build.js",
    "test:contact": "node scripts/test-contact-validation.js",
    "test:pricing": "node scripts/test-pricing.js",
    "test:seo": "node scripts/test-seo.js",
    "audit": "npm audit --audit-level=high",
    "test:static": "node scripts/build.js && node scripts/typecheck.js && node scripts/test-contact-validation.js && node scripts/test-pricing.js && node scripts/test-seo.js && npm audit --audit-level=high"
  },
  "devDependencies": {
    "eslint": "^9.31.0"
  }
}
